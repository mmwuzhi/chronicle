{
  "manifest_version": 3,
  "name": "Chronicle Quick Capture",
  "description": "Save a page or selected text to Chronicle.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Chronicle"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
