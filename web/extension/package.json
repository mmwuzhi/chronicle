{
  "name": "@chronicle/browser-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run src",
    "package": "pnpm build && rm -f chronicle-extension.zip && cd dist && zip -qr ../chronicle-extension.zip .",
    "e2e": "pnpm build && playwright test -c playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.8"
  }
}
