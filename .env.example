DATABASE_URL=postgres://chronicle:chronicle@localhost:5432/chronicle?sslmode=disable
# Transitional auth-state bridge for OAuth/WebAuthn ceremonies spanning the
# PostgreSQL migration deployment. Remove after all old states have expired.
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-a-long-random-string
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# File uploads. Cloudflare R2 remains backward compatible:
R2_BUCKET_NAME=chronicle
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
# For self-hosting or another S3-compatible provider, configure every generic
# value below. Generic settings take precedence over the R2 values above.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
# Largest accepted Chronicle archive, both compressed and uncompressed (2 GiB).
ARCHIVE_MAX_BYTES=2147483648

# Optional transcription
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Vision model for transcribing image captures (receipts/screenshots/photos) to
# searchable text. OFF by default — when enabled, each uploaded image is sent to
# the vision provider. Requires OPENAI_API_KEY.
OPENAI_VISION_MODEL=gpt-4o-mini
VISION_ENABLED=false
# Link enrichment: when a text capture contains a URL, fetch the page's readable
# text into the capture's transcript so it becomes findable by content, not just
# the pasted URL. OFF by default. Needs no API key; enabling it also enqueues a
# one-time backfill of existing URL captures. Fetches run behind an SSRF guard
# (private/loopback addresses are refused).
LINK_FETCH_ENABLED=false
GEMINI_API_KEY=

# Email (required for password reset and email verification)
RESEND_API_KEY=

# OAuth login/linking
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Bot protection on registration
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Passkeys / WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# Frontend API base URL
VITE_API_URL=http://localhost:8080

# Browser-only Google Drive uploads. This may use the same OAuth web client ID
# as GOOGLE_CLIENT_ID when that client allows your frontend origin.
VITE_GOOGLE_CLIENT_ID=

# macOS Google Drive attachments. Use a Google OAuth Desktop client ID.
# Packaged builds may instead set ChronicleGoogleDriveClientID in desktop/Info.plist.
CHRONICLE_GOOGLE_DRIVE_CLIENT_ID=

# Show the Ask tab in a production build. Dev always shows it. Set true only on a
# deployment that actually runs the RAG sidecar, so prod users don't get a tab
# that 503s. (Search degrades to keyword FTS on its own and needs no flag.)
VITE_ASK_ENABLED=false

# RAG sidecar (Python). Empty disables semantic search/ask; the API falls back to
# keyword FTS. The sidecar is host-run (`make rag`) in the local-first setup —
# it and Ollama are not containerized yet.
#   - API on the host (`make api`):           http://localhost:5400
#   - API in Docker (`make dev` full stack):  http://host.docker.internal:5400
# Set whichever matches how you run the API; default assumes the host flow.
RAG_SERVICE_URL=http://localhost:5400

# ragsvc config (read by the Python service, not the Go API)
RAG_PORT=5400
# Default form needs NO model install — only the `claude` CLI:
#   - extraction + analysis run through the claude -p agent
#   - the semantic vector channel is OFF (EMBED_ENABLED=false)
#   - rerank=auto resolves to off when no local Ollama is present
# Turn semantic search on without installing anything by pointing the embedder at
# an OpenAI-compatible endpoint: EMBED_ENABLED=true + EMBED_BACKEND=openai (reuses
# OPENAI_API_KEY above). Privacy note: cloud embedding sends each capture's text
# to the embedding provider — opt-in, off by default.
EMBED_ENABLED=false
# embedding backend: ollama (local, needs Ollama) | openai (OpenAI-compatible
# /v1/embeddings, BYOK, no install). Switching backend changes the vector space —
# rerun `make rag-backfill` (or POST /backfill) to re-embed the corpus.
EMBED_BACKEND=ollama
# open metadata extraction: claude (agent, no install) | api (OpenAI-compatible,
# BYOK) | ollama (local model)
EXTRACT_BACKEND=claude
# analysis backend: claude (claude -p) | api (OpenAI-compatible, BYOK) | ollama
ANALYZER_BACKEND=claude
# rerank backend: auto | local | cross_encoder | claude | api | off
RERANK_BACKEND=auto
# Cloud rerank (api backend): a generic /rerank endpoint, BYOK. Vendor-agnostic —
# jina / cohere / voyage all speak {model,query,documents} → {results:[{index,
# relevance_score}]}. Empty = api backend unavailable; unconfigured/failure falls
# back to vector ordering, never breaks search.
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL_API=rerank-2
# In-process corpus cache in the RAG sidecar. Each /find and /ask reloads a
# user's whole corpus (content + embedding bytes) from Postgres and rebuilds the
# numpy matrix; caching the decoded snapshot per user (this is a single-process
# service) removes that per-search reload. Writes through the sidecar invalidate
# immediately; the TTL bounds staleness from writes the Go API makes on its own
# (soft-delete / restore). Set CORPUS_CACHE_TTL=0 to disable (always reload).
CORPUS_CACHE_TTL=60
CORPUS_CACHE_MAX_USERS=32
# Chunked embeddings: long content is split into overlapping character windows,
# each embedded on its own, so a long capture (a fetched link page, a long
# transcript) is findable by any of its parts. Short content stays a single
# chunk. After first deploy of this feature, run `just rag-backfill` once to
# re-chunk the existing corpus (needs_index treats the old single-vector rows as
# stale). Defaults suit a few-hundred-token window; leave them unless tuning.
CHUNK_CHARS=1200
CHUNK_OVERLAP=180
# only used when the corresponding backend is set to ollama / EMBED_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL_BGE=bge-m3
EXTRACT_MODEL=qwen3.5:4b
ANALYZER_MODEL=qwen3.5:4b
# OpenAI-compatible (api) backend models. Reuses OPENAI_API_KEY / OPENAI_BASE_URL
# above (the same key the transcription path uses). Any /v1-compatible endpoint
# works: OpenAI, Gemini's compat endpoint, DeepSeek, a local vLLM/LM Studio…
OPENAI_MODEL=gpt-4o-mini
EMBED_MODEL_OPENAI=text-embedding-3-small
# Override only when the embedding endpoint is a different provider than chat;
# empty = reuse OPENAI_BASE_URL / OPENAI_API_KEY. Decided online default is Voyage
# (OpenAI-compatible, best retrieval quality): EMBED_BASE_URL=https://api.voyageai.com/v1
# + EMBED_MODEL_OPENAI=voyage-4-lite (cheap, 200M free tokens). The desktop's
# offline semantic layer stays on local Ollama bge-m3 — a separate vector space by
# design, so the server is free to pick the best model.
EMBED_BASE_URL=
EMBED_API_KEY=

PORT=8080
ENV=development
