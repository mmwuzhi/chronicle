# Public entrypoint. For production, set both values to the same HTTPS domain.
SITE_ADDRESS=http://localhost
PUBLIC_URL=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
WEBAUTHN_RP_ID=localhost

# Generated by scripts/selfhost.sh on first use.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
JWT_SECRET=__JWT_SECRET__
MINIO_ROOT_USER=__MINIO_ROOT_USER__
MINIO_ROOT_PASSWORD=__MINIO_ROOT_PASSWORD__
OBJECT_STORAGE_BUCKET=chronicle

# Core settings
ENV=production
PORT=8080
ARCHIVE_MAX_BYTES=2147483648
LINK_FETCH_ENABLED=false
VISION_ENABLED=false

# Optional integrations
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TURNSTILE_SECRET_KEY=

# Leave empty for full-text search only. To enable the optional Compose profile,
# set this to http://ragsvc:5400 and start with SELFHOST_RAG=1.
RAG_SERVICE_URL=
EMBED_ENABLED=false
EMBED_BACKEND=ollama
EXTRACT_BACKEND=api
ANALYZER_BACKEND=api
RERANK_BACKEND=off
CORPUS_CACHE_TTL=60
CORPUS_CACHE_MAX_USERS=32
CHUNK_CHARS=1200
CHUNK_OVERLAP=180
